<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Laptop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid mx-5 py-1">
            <img src="../../assets/images/logo-laptop.jpg" alt="Logo" width="40" class="d-inline-block align-text-top">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav gap-4 ms-4 d-flex w-100">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" aria-current="page" href="../../">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold active" href="../../my-laptop">My Laptop</a>
                    </li>
                    <li class="nav-item ms-auto">
                        <a href="../../contact-us"><button type="button" class="btn btn-dark fw-semibold px-3">Contact Us</button></a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid bg-light pb-5">
        <!-- Formulir Add Laptop -->
        <div class="row align-items-start justify-content-center">
            <div class="col-4">
                <h1 class="text-center p-5 fw-bold">EDIT MY LAPTOP</h1>
                {{#each result.rows}}
                <form id="myLaptop" method="POST" action="/my-laptop/update">
                <input type="text" name="id" value="{{id}}" hidden>
                    <div class="mb-4">
                        <label for="namaLaptop" class="form-label fw-semibold">Nama Laptop</label>
                        <input type="text" class="form-control shadow-sm" id="namaLaptop" name="namaLaptop" value="{{nama}}" placeholder="Masukkan Nama Laptop" autocomplete="off" required>
                    </div>
                    <div class="mb-4">
                        <label for="tanggalBeli" class="form-label fw-semibold">Tanggal Beli</label>
                        <input type="date" class="form-control shadow-sm" id="tanggalBeli" name="tanggalBeli" value="{{tanggal_input}}" autocomplete="off" required>
                    </div>
                    <div class="mb-4">
                        <label for="deskripsi" class="form-label fw-semibold">Description</label>
                        <textarea class="form-control shadow-sm" id="deskripsi" name="deskripsi" style="height: 200px" rows="3" required>{{deskripsi}}</textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Kondisi</label>
                        <br>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="monitorBagus" name="monitorBagus" value="option1" {{#if monitor_bagus}} checked {{/if}}>
                            <label class="form-check-label" for="monitorBagus">Monitor Bagus</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="keyboardBagus" name="keyboardBagus" value="option2" {{#if keyboard_bagus}} checked {{/if}}>
                            <label class="form-check-label" for="keyboardBagus">Keyboard Bagus</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="casingBagus" name="casingBagus" value="option3" {{#if casing_bagus}} checked {{/if}}>
                            <label class="form-check-label" for="casingBagus">Casing Bagus</label>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="formFile" class="form-label fw-semibold">Gambar Laptop</label>
                        <input class="form-control" type="file" id="formFile">
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-dark px-4 rounded rounded-pill">Submit</button>
                    </div>
                {{/each}}
                </form>
            </div>
        </div>
    </div>
</body>
</html>