<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Laptop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid mx-5 py-1">
            <img src="assets/images/logo-laptop.jpg" alt="Logo" width="40" class="d-inline-block align-text-top">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav gap-4 ms-4 d-flex w-100">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" aria-current="page" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold active" href="my-laptop">My Laptop</a>
                    </li>
                    <li class="nav-item ms-auto">
                        <a href="contact-us"><button type="button" class="btn btn-dark fw-semibold px-3">Contact Us</button></a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid bg-light pb-5">
        <!-- Formulir Add Laptop -->
        <div class="row align-items-start justify-content-center">
            <div class="col-4">
                <h1 class="text-center p-5 fw-bold">ADD MY LAPTOP</h1>
                <form id="myLaptop" method="POST" action="/my-laptop">
                    <div class="mb-4">
                        <label for="namaLaptop" class="form-label fw-semibold">Nama Laptop</label>
                        <input type="text" class="form-control shadow-sm" id="namaLaptop" name="namaLaptop" placeholder="Masukkan Nama Laptop" autocomplete="off" required>
                    </div>
                    <div class="mb-4">
                        <label for="tanggalBeli" class="form-label fw-semibold">Tanggal Beli</label>
                        <input type="date" class="form-control shadow-sm" id="tanggalBeli" name="tanggalBeli" autocomplete="off" required>
                    </div>
                    <div class="mb-4">
                        <label for="deskripsi" class="form-label fw-semibold">Description</label>
                        <textarea class="form-control shadow-sm" id="deskripsi" name="deskripsi" style="height: 200px" rows="3" required></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Kondisi</label>
                        <br>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="monitorBagus" name="monitorBagus" value="option1">
                            <label class="form-check-label" for="monitorBagus">Monitor Bagus</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="keyboardBagus" name="keyboardBagus" value="option2">
                            <label class="form-check-label" for="keyboardBagus">Keyboard Bagus</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="casingBagus" name="casingBagus" value="option3">
                            <label class="form-check-label" for="casingBagus">Casing Bagus</label>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="formFile" class="form-label fw-semibold">Gambar Laptop</label>
                        <input class="form-control" type="file" id="formFile">
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-dark px-4 rounded rounded-pill">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Hasil Form -->
    <div class="container mt-5 {{#unless result.rows.length }}d-none{{/unless}}" id="sectionHasil">
        <h1 class="text-center mb-5">My Laptop</h1>
        {{!-- <div class="d-flex justify-content-center mb-4">
            <select id="filterKondisi" class="mt-4 shadow-sm text-center" aria-label="Default select example">
                <option value="semua">Bagus Semua</option>
                <option value="monitor">Monitor Bagus</option>
                <option value="keyboard">Keyboard Bagus</option>
                <option value="casing">Casing Bagus</option>
            </select>
        </div> --}}
        <div id="hasil" class="row mb-3">
        {{#each result.rows}}
            <div class="col d-flex justify-content-center mb-4">
                <div class="card shadow-lg" style="width: 18rem;">
                    <div class="card-body">
                        <h5 class="card-title">{{nama}}</h5>
                        <p class="card-text">Tanggal Beli: {{tanggal_rapi}}</p>
                        <p class="card-text">{{deskripsi}}.</p>
                        <div class="d-flex align-items-center gap-4 justify-content-center mb-3">
                            {{#if monitor_bagus}}<i class="bi bi-display fs-2"></i>{{/if}}
                            {{#if keyboard_bagus}}<i class="bi bi-keyboard fs-4"></i>{{/if}}
                            {{#if casing_bagus}}<i class="bi bi-laptop fs-2"></i>{{/if}}
                        </div >
                        <div class="row">
                            <div class="col">
                                <a href="/my-laptop/edit/{{id}}"><button type="submit" class="btn btn-dark w-100">Edit</button></a>
                            </div>
                            <div class="col">
                                <form action="/my-laptop/delete/{{id}}" method="post" onsubmit="return confirm('Apakah anda yakin ingin menghapus laptop ini?');">
                                    <button type="submit" class="btn btn-dark w-100">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div >
                </div >
            </div >
        {{/each}}
        </div>
    </div>
    {{!-- <script src="assets/scripts/addLaptop.js"></script> --}}
</body>
</html>